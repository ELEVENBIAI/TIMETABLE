# Linear
LINEAR_API_KEY=

# Telegram (optional — für Self-Healing Alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Research (optional)
OPENROUTER_API_KEY=

# Automation Daemon (optional)
LINEAR_WEBHOOK_SECRET=
DAEMON_PORT=3001

# Claude Code
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/timetable

# Auth
JWT_SECRET=
# Vorheriges Secret während Rotation (ELE-188 / ADR-18). Leer = keine Rotation aktiv.
# Wird nur zum Verifizieren benutzt, nie zum Signieren. Nach 7 Tagen entfernen.
JWT_SECRET_PREVIOUS=
JWT_EXPIRES_IN=7d

# App
NODE_ENV=development
PORT=3000

# Error-Tracking (ELE-189 / ADR-17) — leer = kein Tracking, alles bleibt no-op
# GlitchTip (self-hosted) oder Sentry SaaS
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Source-Maps-Upload (nur in CI / Production-Builds)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=

# Frontend Vite (mit VITE_-Prefix, sonst nicht im Bundle)
VITE_SENTRY_DSN=
VITE_APP_VERSION=
